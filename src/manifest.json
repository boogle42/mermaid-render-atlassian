{
  "manifest_version": 3,
  "name": "Mermaid Render for Jira, Confluence & Bitbucket",
  "short_name": "Mermaid Render",
  "version": "0.1.0",
  "description": "Renders Mermaid code blocks as diagrams in Jira, Confluence and Bitbucket. Runs locally; sends nothing anywhere.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["scripting", "storage"],
  "host_permissions": [
    "https://*.atlassian.net/*",
    "https://*.jira.com/*",
    "https://bitbucket.org/*"
  ],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.atlassian.net/*",
        "https://*.jira.com/*",
        "https://bitbucket.org/*"
      ],
      "js": ["content/detect.js", "content/main.js"],
      "css": ["content/style.css"],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": false
  },
  "action": {
    "default_title": "Mermaid Render settings"
  }
}
